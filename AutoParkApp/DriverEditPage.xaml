<Page x:Class="AutoParkApp.DriverEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AutoParkApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DriverEditPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Width="340" HorizontalAlignment="Center">
            <TextBlock x:Name="tbTitle" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

            <TextBlock Text="ФИО"/>
            <TextBox Text="{Binding FullName}"/>
            <TextBlock Text="Номер ВУ" Margin="0,8,0,0"/>
            <TextBox Text="{Binding LicenseNumber}"/>
            <TextBlock Text="Телефон" Margin="0,8,0,0"/>
            <TextBox Text="{Binding PhoneNumber}"/>
            <TextBlock Text="Стаж, лет" Margin="0,8,0,0"/>
            <TextBox Text="{Binding Experience}"/>
            <TextBlock Text="Email" Margin="0,8,0,0"/>
            <TextBox Text="{Binding Email}"/>
            <TextBlock Text="Пароль" Margin="0,8,0,0"/>
            <TextBox Text="{Binding Password}"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Сохранить" Width="110" Click="Save_Click"/>
                <Button Content="Назад" Width="110" Margin="10,0,0,0" Click="Back_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
