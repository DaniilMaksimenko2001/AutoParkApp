<Page x:Class="AutoParkApp.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AutoParkApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegistrationPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="225"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0"  Orientation="Horizontal">
                <TextBlock Width="200" Text="ФИО"/>
                <TextBox Name="FullNameBox" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="1">
                <TextBlock Text="Номер удостоверения" Width="200"/>
                <TextBox Name="LicenseNumberBox" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="2">
                <TextBlock Text="Телефон" Width="200"/>
                <TextBox Name="PhoneNumberBox" Width="200"/>
            </StackPanel>
            <StackPanel Grid.Row="3"  Orientation="Horizontal">
                <TextBlock Width="200" Text="Стаж (лет)"/>
                <TextBox Name="ExperienceBox" Width="200"/>
            </StackPanel>
            <StackPanel Grid.Row="4"  Orientation="Horizontal">
                <TextBlock Width="200" Text="Email"/>
                <TextBox Name="EmailBox" Width="200"/>
            </StackPanel>
            <StackPanel Grid.Row="5"  Orientation="Horizontal">
                <TextBlock Width="200" Text="Пароль"/>
                <TextBox Name="PasswordBox" Width="200"/>
            </StackPanel>
            <StackPanel Grid.Row="6"  Orientation="Horizontal">
                <TextBlock Width="200" Text="Повтор пароля"/>
                <TextBox Name="PasswordRepeatBox" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="7">
                <Button Content="Сохранить" Width="200" Click="SaveUserClick"/>
                <Button Content="К логину" Width="200" Click="OpenLoginPage"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
