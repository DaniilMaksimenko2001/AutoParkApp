<Page x:Class="AutoParkApp.RouteEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AutoParkApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RouteEditPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Width="360" HorizontalAlignment="Center">
            <TextBlock Text="Новый рейс" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

            <TextBlock Text="Транспортное средство (только доступные)"/>
            <ComboBox x:Name="cbVehicle" DisplayMemberPath="LicensePlate" SelectedValuePath="Id"/>
            <TextBlock Text="Водитель" Margin="0,8,0,0"/>
            <ComboBox x:Name="cbDriver" DisplayMemberPath="FullName" SelectedValuePath="Id"/>

            <TextBlock Text="Начало" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal">
                <DatePicker x:Name="dpStart" Width="170"/>
                <TextBox x:Name="tbStartTime" Width="60" Margin="6,0" Text="08:00"/>
            </StackPanel>
            <TextBlock Text="Окончание" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal">
                <DatePicker x:Name="dpEnd" Width="170"/>
                <TextBox x:Name="tbEndTime" Width="60" Margin="6,0" Text="18:00"/>
            </StackPanel>

            <TextBlock Text="Откуда" Margin="0,8,0,0"/>
            <TextBox x:Name="tbFrom"/>
            <TextBlock Text="Куда" Margin="0,8,0,0"/>
            <TextBox x:Name="tbTo"/>
            <TextBlock Text="Расстояние, км" Margin="0,8,0,0"/>
            <TextBox x:Name="tbDistance"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Зарегистрировать" Width="140" Click="Save_Click"/>
                <Button Content="Назад" Width="110" Margin="10,0,0,0" Click="Back_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
